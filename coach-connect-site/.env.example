# Public web config for the Coach Connect Firebase project (anatrox-auth).
# Copy to .env.local and fill from the Firebase console → Project settings → Your apps → Web.
# These are client keys, not the admin service account. Restart `yarn start` after editing.

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=anatrox-auth.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=anatrox-auth
REACT_APP_FIREBASE_STORAGE_BUCKET=anatrox-auth.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_API_BASE_URL=https://coachconnect-api-421005574501.us-central1.run.app
